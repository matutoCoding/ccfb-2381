{
  "name": "strat3d",
  "version": "1.0.0",
  "private": true,
  "description": "浏览器内三维地层建模工具（钻孔数据 / 层位插值 / WebGPU 体素 / 剖面）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
